<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chiru.engine</groupId>
        <artifactId>code-intelligence-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>cli</artifactId>
    <name>cli</name>
    <description>Command line entry point; builds the runnable jar code-intelligence-engine.jar</description>

    <dependencies>
        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>syntax</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>paths</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>source-spoon</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>bytecode-sootup</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>sql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>rules</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>lineage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>scenarios</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>validation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>docs</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <dependency>
            <groupId>com.chiru.engine</groupId>
            <artifactId>sample-app</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>code-intelligence-engine</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.chiru.engine.cli.Main</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
